tag: browser
title: /Calendar/
-
# Make sure to disable Vimium 
# You must also enable shortcuts in google calendar


# Move around the calendar
period next: key(n)
period (last|previous): key(p)
refresh:key(r)
today: key(t)
go to date: key(g)

# Views
view day: key(d)
view week: key(w)
view month: key(m)
view custom: key(x)
view schedule: key(a)
view year: key(y)

# Actions
event (create|new): key(c)
event quick create: key(q) 
event edit: key(e)
event delete: key(delete)

# Application
search: key(/)
search people: key(+)